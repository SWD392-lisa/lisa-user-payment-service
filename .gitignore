## .gitignore for ASP.NET Core / .NET 8 Solution

# ========================
# Build outputs
# ========================
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ========================
# Visual Studio / Rider
# ========================
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# ========================
# NuGet
# ========================
*.nupkg
*.snupkg
.nuget/packages/
packages/
!.nuget/NuGet.Config
project.lock.json
project.fragment.lock.json
artifacts/

# ========================
# Secrets & Environment
# ========================
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings*.json
secrets.json
*.pfx
*.p12
.env
.env.*

# ========================
# User Secrets (dotnet user-secrets)
# ========================
%APPDATA%\Microsoft\UserSecrets\
~/.microsoft/usersecrets/

# ========================
# Publish output
# ========================
**/publish/
**/PublishProfiles/

# ========================
# Test results
# ========================
TestResults/
*.trx
*.coverage
*.coveragexml

# ========================
# OS generated
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# Rider / JetBrains
# ========================
.idea/
*.sln.iml

# ========================
# Docker
# ========================
docker-compose.override.yml

# ========================
# Misc
# ========================
*.bak
*.tmp
*.temp
